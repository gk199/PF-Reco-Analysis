// Option 1: Timing cut applied in both the per-depth topo-clustering step
// (Basic2DGenericTopoClusterizer_timing.cc.edit) AND here when absorbing depth
// clusters into the final stacked cluster.
//
// Before merging, a pre-pass identifies all per-depth clusters that will be
// linked together and finds the one with the highest-energy seed.  That seed's
// time is used as the fixed reference for all subsequent timing checks when
// absorbing cells from every depth cluster.  This guarantees that every cell
// in the final merged cluster is within _timeThreshold of the global
// highest-energy seed, regardless of which depth that seed lives in and
// regardless of the order clusters are absorbed.
//
// OOT cell recovery: cells that fail the per-cell timing cut during absorption
// are NOT permanently dropped.  Instead each such cell is collected into a
// per-source-depth-cluster residual PFCluster.  After the full in-time (IT)
// pass, residuals are iteratively re-clustered: within each OOT group the
// highest-energy seed's time is used as the fixed timing reference (mirroring
// the IT pre-pass), cells within the threshold are merged, and cells outside
// form further residuals for the next iteration.  This guarantees every output
// cluster — IT or OOT — is internally time-consistent, while still allowing a
// cell that fails one cluster's timing window to join a spatially and temporally
// compatible OOT group.
//
// To use: copy this file to
//   RecoParticleFlow/PFClusterProducer/plugins/PFMultiDepthClusterizer.cc
// replacing the original, and rebuild.  Use together with
//   Basic2DGenericTopoClusterizer_timing.cc.edit (copied to the same plugins dir)
// and the matching cfi files.

#include "DataFormats/Math/interface/deltaPhi.h"
#include "DataFormats/Math/interface/deltaR.h"
#include "DataFormats/ParticleFlowReco/interface/PFRecHit.h"
#include "DataFormats/ParticleFlowReco/interface/PFRecHitFraction.h"
#include "FWCore/Framework/interface/ConsumesCollector.h"
#include "FWCore/MessageLogger/interface/MessageLogger.h"
#include "Math/GenVector/VectorUtil.h"
#include "RecoParticleFlow/PFClusterProducer/interface/PFClusterBuilderBase.h"
#include "CondFormats/DataRecord/interface/HcalPFCutsRcd.h"
#include "CondTools/Hcal/interface/HcalPFCutsHandler.h"
#include "vdt/vdtMath.h"

#include <iterator>
#include <unordered_map>

class PFMultiDepthClusterizer final : public PFClusterBuilderBase {
  typedef PFMultiDepthClusterizer B2DGPF;

public:
  PFMultiDepthClusterizer(const edm::ParameterSet& conf, edm::ConsumesCollector& cc);

  ~PFMultiDepthClusterizer() override = default;
  PFMultiDepthClusterizer(const B2DGPF&) = delete;
  B2DGPF& operator=(const B2DGPF&) = delete;

  void update(const edm::EventSetup& es) override { _allCellsPosCalc->update(es); }

  void buildClusters(const reco::PFClusterCollection&,
                     const std::vector<bool>&,
                     reco::PFClusterCollection& outclus,
                     const HcalPFCuts*) override;

private:
  std::unique_ptr<PFCPositionCalculatorBase> _allCellsPosCalc;
  double nSigmaEta_;
  double nSigmaPhi_;
  // timing settings
  const bool _useTiming;
  const double _timeThreshold;

  class ClusterLink {
  public:
    ClusterLink(unsigned int i, unsigned int j, double DR, int DZ, double energy) {
      from_ = i;
      to_ = j;
      linkDR_ = DR;
      linkDZ_ = DZ;
      linkE_ = energy;
    }

    ~ClusterLink() = default;

    unsigned int from() const { return from_; }
    unsigned int to() const { return to_; }
    double dR() const { return linkDR_; }
    int dZ() const { return linkDZ_; }
    double energy() const { return linkE_; }

  private:
    unsigned int from_;
    unsigned int to_;
    double linkDR_;
    int linkDZ_;
    double linkE_;
  };

  void calculateShowerShapes(const reco::PFClusterCollection&, std::vector<double>&, std::vector<double>&);
  std::vector<ClusterLink> link(const reco::PFClusterCollection&,
                                const std::vector<double>&,
                                const std::vector<double>&);
  std::vector<ClusterLink> prune(std::vector<ClusterLink>&, std::vector<bool>& linkedClusters);

  // Traverse prunedLinks from 'point' in both directions, collecting all
  // reachable cluster indices into 'result'.  'visited' must be pre-sized to
  // input.size() and have visited[point]=true before the first call.
  void collectLinked(unsigned int point,
                     std::vector<bool>& visited,
                     const std::vector<ClusterLink>& links,
                     std::vector<unsigned int>& result) const;

  // Absorb rechits from 'added' into 'main'.  Rechits passing the timing cut go
  // into 'main'; rechits failing it go into '*residual' (if residual is
  // non-null).  The seed of *residual is set to the highest-energy OOT rechit.
  // Pass refSeedTime < -998 (e.g. -999) to disable the timing cut entirely
  // (used in the OOT re-clustering pass).
  // Returns true if the added cluster's seed was accepted into main.
  bool absorbCluster(reco::PFCluster& main,
                     const reco::PFCluster& added,
                     double refSeedTime,
                     reco::PFCluster* residual);

  // Traverse links from 'point', absorbing neighbours into 'cluster'.
  // OOT cells from each absorbed depth cluster are collected as a residual
  // PFCluster and appended to 'residuals' (to be re-clustered in the OOT pass).
  // Recursion stops at a depth cluster whose seed is OOT (its remaining sub-
  // links are not traversed; the sub-cluster's deeper neighbours will be picked
  // up by the outer buildClusters loop as independent anchors).
  void expandCluster(reco::PFCluster&,
                     unsigned int point,
                     std::vector<bool>& mask,
                     const reco::PFClusterCollection&,
                     const std::vector<ClusterLink>& links,
                     double refSeedTime,
                     reco::PFClusterCollection& residuals);
};

DEFINE_EDM_PLUGIN(PFClusterBuilderFactory, PFMultiDepthClusterizer, "PFMultiDepthClusterizer");

PFMultiDepthClusterizer::PFMultiDepthClusterizer(const edm::ParameterSet& conf, edm::ConsumesCollector& cc)
    : PFClusterBuilderBase(conf, cc),
      _useTiming(conf.getUntrackedParameter<bool>("useTiming", true)),
      _timeThreshold(conf.getUntrackedParameter<double>("timeThreshold", 3)) {
  const auto& acConf = conf.getParameterSet("allCellsPositionCalc");
  if (!acConf.empty()) {
    const std::string& algoac = acConf.getParameter<std::string>("algoName");
    if (!algoac.empty())
      _allCellsPosCalc = PFCPositionCalculatorFactory::get()->create(algoac, acConf, cc);
  }

  nSigmaEta_ = pow(conf.getParameter<double>("nSigmaEta"), 2);
  nSigmaPhi_ = pow(conf.getParameter<double>("nSigmaPhi"), 2);
}

void PFMultiDepthClusterizer::buildClusters(const reco::PFClusterCollection& input,
                                            const std::vector<bool>& seedable,
                                            reco::PFClusterCollection& output,
                                            const HcalPFCuts* hcalCuts) {
  std::vector<double> etaRMS2(input.size(), 0.0);
  std::vector<double> phiRMS2(input.size(), 0.0);

  calculateShowerShapes(input, etaRMS2, phiRMS2);

  auto&& links = link(input, etaRMS2, phiRMS2);

  std::vector<bool> mask(input.size(), false);
  std::vector<bool> linked(input.size(), false);

  auto&& prunedLinks = prune(links, linked);

  // allResiduals collects per-depth pseudo-clusters built from OOT cells that
  // were rejected during the IT absorption pass.  They are re-clustered together
  // in the OOT pass below (pure spatial linking, no timing restriction).
  reco::PFClusterCollection allResiduals;

  for (unsigned int i = 0; i < input.size(); ++i) {
    if (mask[i])
      continue;
    if (!linked[i]) {
      output.push_back(input[i]);
      mask[i] = true;
      continue;
    }

    // Pre-pass: collect all per-depth cluster indices that will be merged with i.
    std::vector<bool> visited(input.size(), false);
    visited[i] = true;
    std::vector<unsigned int> toMerge = {i};
    collectLinked(i, visited, prunedLinks, toMerge);

    // Find the highest-energy seed among all clusters to be merged.
    // Use its time as the fixed reference for all timing checks below.
    // HB only: a merge group can straddle the HB/HE overlap, and an HE reference
    // time would be meaningless.  No HB seed leaves -999, disabling the cut.
    double refSeedTime = -999.0;
    double maxSeedEnergy = -1.0;
    for (unsigned int idx : toMerge) {
      for (const auto& frac : input[idx].recHitFractions()) {
        if (frac.recHitRef()->detId() == input[idx].seed()) {
          if (frac.recHitRef()->layer() == PFLayer::HCAL_BARREL1 && frac.recHitRef()->energy() > maxSeedEnergy) {
            maxSeedEnergy = frac.recHitRef()->energy();
            refSeedTime = frac.recHitRef()->time();
          }
          break;  // seed found for this depth cluster
        }
      }
    }

    reco::PFCluster cluster = input[i];
    mask[i] = true;
    expandCluster(cluster, i, mask, input, prunedLinks, refSeedTime, allResiduals);
    _allCellsPosCalc->calculateAndSetPosition(cluster, hcalCuts);
    output.push_back(cluster);
  }

  // OOT passes: iteratively re-cluster residuals with the same timing
  // consistency requirement as the IT pass.  Within each OOT group the
  // highest-energy seed's time is used as the fixed reference; cells that fail
  // form further residuals that are re-processed in the next iteration.
  // Terminates when no new residuals are produced.
  reco::PFClusterCollection currentPool = std::move(allResiduals);

  while (!currentPool.empty()) {
    // Position-calculate each entry so that depth() and positionREP() are
    // valid for shower-shape and spatial-link steps.
    for (auto& res : currentPool)
      _allCellsPosCalc->calculateAndSetPosition(res, hcalCuts);

    std::vector<double> poolEtaRMS2(currentPool.size(), 0.0);
    std::vector<double> poolPhiRMS2(currentPool.size(), 0.0);
    calculateShowerShapes(currentPool, poolEtaRMS2, poolPhiRMS2);

    auto poolRawLinks = link(currentPool, poolEtaRMS2, poolPhiRMS2);

    std::vector<bool> poolLinked(currentPool.size(), false);
    auto poolPrunedLinks = prune(poolRawLinks, poolLinked);

    std::vector<bool> poolMask(currentPool.size(), false);
    reco::PFClusterCollection nextPool;

    for (unsigned int i = 0; i < currentPool.size(); ++i) {
      if (poolMask[i])
        continue;
      if (!poolLinked[i]) {
        output.push_back(currentPool[i]);
        poolMask[i] = true;
        continue;
      }

      // Pre-pass: find the highest-energy seed among all clusters in this OOT
      // group to use as the fixed timing reference (mirrors the IT pre-pass).
      std::vector<bool> visited(currentPool.size(), false);
      visited[i] = true;
      std::vector<unsigned int> toMerge = {i};
      collectLinked(i, visited, poolPrunedLinks, toMerge);

      // HB-only, as in the IT pre-pass above.
      double refSeedTimeOOT = -999.0;
      double maxSeedEnergyOOT = -1.0;
      for (unsigned int idx : toMerge) {
        for (const auto& frac : currentPool[idx].recHitFractions()) {
          if (frac.recHitRef()->detId() == currentPool[idx].seed()) {
            if (frac.recHitRef()->layer() == PFLayer::HCAL_BARREL1 &&
                frac.recHitRef()->energy() > maxSeedEnergyOOT) {
              maxSeedEnergyOOT = frac.recHitRef()->energy();
              refSeedTimeOOT = frac.recHitRef()->time();
            }
            break;
          }
        }
      }

      reco::PFCluster cluster = currentPool[i];
      poolMask[i] = true;
      expandCluster(cluster, i, poolMask, currentPool, poolPrunedLinks, refSeedTimeOOT, nextPool);
      _allCellsPosCalc->calculateAndSetPosition(cluster, hcalCuts);
      output.push_back(cluster);
    }

    currentPool = std::move(nextPool);
  }
}

void PFMultiDepthClusterizer::collectLinked(unsigned int point,
                                            std::vector<bool>& visited,
                                            const std::vector<ClusterLink>& links,
                                            std::vector<unsigned int>& result) const {
  for (const auto& link : links) {
    if (link.from() == point && !visited[link.to()]) {
      visited[link.to()] = true;
      result.push_back(link.to());
      collectLinked(link.to(), visited, links, result);
    }
    if (link.to() == point && !visited[link.from()]) {
      visited[link.from()] = true;
      result.push_back(link.from());
      collectLinked(link.from(), visited, links, result);
    }
  }
}

void PFMultiDepthClusterizer::calculateShowerShapes(const reco::PFClusterCollection& clusters,
                                                    std::vector<double>& etaRMS2,
                                                    std::vector<double>& phiRMS2) {
  for (unsigned int i = 0; i < clusters.size(); ++i) {
    const reco::PFCluster& cluster = clusters[i];
    double etaSum = 0.0;
    double phiSum = 0.0;
    auto const& crep = cluster.positionREP();
    for (const auto& frac : cluster.recHitFractions()) {
      auto const& h = *frac.recHitRef();
      auto const& rep = h.positionREP();
      etaSum += (frac.fraction() * h.energy()) * std::abs(rep.eta() - crep.eta());
      phiSum += (frac.fraction() * h.energy()) * std::abs(deltaPhi(rep.phi(), crep.phi()));
    }
    etaRMS2[i] = std::max(etaSum / cluster.energy(), 0.1);
    etaRMS2[i] *= etaRMS2[i];
    phiRMS2[i] = std::max(phiSum / cluster.energy(), 0.1);
    phiRMS2[i] *= phiRMS2[i];
  }
}

std::vector<PFMultiDepthClusterizer::ClusterLink> PFMultiDepthClusterizer::link(
    const reco::PFClusterCollection& clusters, const std::vector<double>& etaRMS2, const std::vector<double>& phiRMS2) {
  std::vector<ClusterLink> links;
  for (unsigned int i = 0; i < clusters.size(); ++i)
    for (unsigned int j = 0; j < clusters.size(); ++j) {
      if (i == j)
        continue;

      const reco::PFCluster& cluster1 = clusters[i];
      const reco::PFCluster& cluster2 = clusters[j];

      auto dz = (static_cast<int>(cluster2.depth()) - static_cast<int>(cluster1.depth()));

      if (dz <= 0)
        continue;

      auto const& crep1 = cluster1.positionREP();
      auto const& crep2 = cluster2.positionREP();

      auto deta = crep1.eta() - crep2.eta();
      deta = deta * deta / (etaRMS2[i] + etaRMS2[j]);
      auto dphi = deltaPhi(crep1.phi(), crep2.phi());
      dphi = dphi * dphi / (phiRMS2[i] + phiRMS2[j]);

      if ((deta < nSigmaEta_) & (dphi < nSigmaPhi_))
        links.push_back(ClusterLink(i, j, deta + dphi, std::abs(dz), cluster1.energy() + cluster2.energy()));
    }

  return links;
}

std::vector<PFMultiDepthClusterizer::ClusterLink> PFMultiDepthClusterizer::prune(std::vector<ClusterLink>& links,
                                                                                 std::vector<bool>& linkedClusters) {
  std::vector<ClusterLink> goodLinks;
  std::vector<bool> mask(links.size(), false);
  if (links.empty())
    return goodLinks;

  for (unsigned int i = 0; i < links.size() - 1; ++i) {
    if (mask[i])
      continue;
    for (unsigned int j = i + 1; j < links.size(); ++j) {
      if (mask[j])
        continue;

      const ClusterLink& link1 = links[i];
      const ClusterLink& link2 = links[j];

      if (link1.to() == link2.to()) {
        if (link1.dZ() < link2.dZ()) {
          mask[j] = true;
        } else if (link1.dZ() > link2.dZ()) {
          mask[i] = true;
        } else {
          if (link1.dR() < link2.dR()) {
            mask[j] = true;
          } else if (link1.dR() > link2.dR()) {
            mask[i] = true;
          } else {
            if (link1.energy() < link2.energy())
              mask[i] = true;
            else
              mask[j] = true;
          }
        }
      }
    }
  }

  for (unsigned int i = 0; i < links.size(); ++i) {
    if (mask[i])
      continue;
    goodLinks.push_back(links[i]);
    linkedClusters[links[i].from()] = true;
    linkedClusters[links[i].to()] = true;
  }

  return goodLinks;
}

bool PFMultiDepthClusterizer::absorbCluster(reco::PFCluster& main,
                                            const reco::PFCluster& added,
                                            double refSeedTime,
                                            reco::PFCluster* residual) {
  double e1 = 0.0;
  double e2 = 0.0;
  // Track highest-energy OOT rechit to set the residual's seed.
  double resMaxE = -1.0;
  DetId resSeedId;

  for (const auto& fraction : main.recHitFractions())
    if (fraction.recHitRef()->detId() == main.seed())
      e1 = fraction.recHitRef()->energy();

  bool addedSeedAccepted = false;
  for (const auto& fraction : added.recHitFractions()) {
    // Timing cut against the fixed global highest-energy seed time.
    // Rechits with default invalid time (-999) on either side bypass the cut.
    // refSeedTime < -998 (e.g. -999) disables the cut entirely (OOT pass).
    // HB only: HE rechits are never declared OOT, so a pure-HE stack produces no
    // residuals and reduces exactly to the nominal multi-depth algorithm.
    const bool inHB = (fraction.recHitRef()->layer() == PFLayer::HCAL_BARREL1);
    bool oot = (_useTiming && inHB && refSeedTime > -998.0 && fraction.recHitRef()->time() > -998.0 &&
                std::abs(fraction.recHitRef()->time() - refSeedTime) >= _timeThreshold);
    if (oot) {
      // Route to residual instead of dropping permanently.
      if (residual) {
        residual->addRecHitFraction(fraction);
        if (fraction.recHitRef()->energy() > resMaxE) {
          resMaxE = fraction.recHitRef()->energy();
          resSeedId = fraction.recHitRef()->detId();
        }
      }
      continue;
    }
    main.addRecHitFraction(fraction);
    if (fraction.recHitRef()->detId() == added.seed()) {
      e2 = fraction.recHitRef()->energy();
      addedSeedAccepted = true;
    }
  }
  if (addedSeedAccepted && e2 > e1)
    main.setSeed(added.seed());
  // Set seed on residual so calculateAndSetPosition can find it later.
  if (residual && !residual->recHitFractions().empty())
    residual->setSeed(resSeedId);
  // Return false if the depth cluster's seed was OOT (whole cluster effectively
  // OOT); caller uses this to decide whether to recurse into deeper links.
  return addedSeedAccepted;
}

void PFMultiDepthClusterizer::expandCluster(reco::PFCluster& cluster,
                                            unsigned int point,
                                            std::vector<bool>& mask,
                                            const reco::PFClusterCollection& clusters,
                                            const std::vector<ClusterLink>& links,
                                            double refSeedTime,
                                            reco::PFClusterCollection& residuals) {
  // Helper lambda: absorb one depth cluster, collect any OOT cells into a
  // residual pseudo-cluster, push the residual if non-empty, return whether
  // the absorbed cluster's seed was IT (for recursion decision).
  auto absorb = [&](unsigned int idx) -> bool {
    reco::PFCluster res;
    bool seedAccepted = absorbCluster(cluster, clusters[idx], refSeedTime, &res);
    if (!res.recHitFractions().empty())
      residuals.push_back(std::move(res));
    return seedAccepted;
  };

  for (const auto& link : links) {
    if (link.from() == point) {
      if (!mask[link.from()]) {
        absorb(link.from());  // from==point, already in cluster; no-op if masked
        mask[link.from()] = true;
      }
      if (!mask[link.to()]) {
        bool accepted = absorb(link.to());
        mask[link.to()] = true;
        // Only recurse deeper if the absorbed cluster's seed was IT; if OOT,
        // its downstream links will be picked up as independent anchors by the
        // outer buildClusters loop.
        if (accepted)
          expandCluster(cluster, link.to(), mask, clusters, links, refSeedTime, residuals);
      }
    }
    if (link.to() == point) {
      if (!mask[link.to()]) {
        absorb(link.to());  // to==point, already in cluster; no-op if masked
        mask[link.to()] = true;
      }
      if (!mask[link.from()]) {
        bool accepted = absorb(link.from());
        mask[link.from()] = true;
        if (accepted)
          expandCluster(cluster, link.from(), mask, clusters, links, refSeedTime, residuals);
      }
    }
  }
}
