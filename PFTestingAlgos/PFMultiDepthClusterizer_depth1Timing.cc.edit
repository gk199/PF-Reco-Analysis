// Option 3: Seed-level timing cut using the starting cluster's seed as the
// fixed reference.  Simpler alternative to Option 2.
//
// No pre-pass is needed.  The seed time of input[i] — the first unprocessed
// cluster in this group's iteration order — is read directly and used as the
// fixed reference for all subsequent seed timing checks.  A depth cluster is
// absorbed only if its seed is within _timeThreshold of this reference; if the
// seed fails the entire depth cluster is excluded.
//
// Caveat: input[i] is not strictly guaranteed to be the depth-1 cluster.  The
// input ordering depends on the order Basic2DGenericTopoClusterizer built its
// clusters (sorted by seed energy within each depth, but not sorted by depth
// across the whole collection).  In practice for isolated showers input[i] is
// typically the cluster at or near the shallowest active depth, but this is not
// enforced.  Use Option 2 (PFMultiDepthClusterizer_seedTiming.cc.edit) if a
// strictly defined global reference is required.
//
// Additions over the original PFMultiDepthClusterizer.cc:
//   - _useTiming, _timeThreshold members and constructor parameters
//   - two lines in buildClusters to read refSeedTime from input[i]
//   - refSeedTime threaded through expandCluster and absorbCluster signatures
//   - seed timing check at the top of absorbCluster
//
// To use: copy this file to
//   RecoParticleFlow/PFClusterProducer/plugins/PFMultiDepthClusterizer.cc
// replacing the original, and rebuild.  Use together with the standard
//   Basic2DGenericTopoClusterizer.cc (no per-cell timing cut)
// and particleFlowClusterHCAL_depth1Timing_cfi.py.

#include "DataFormats/Math/interface/deltaPhi.h"
#include "DataFormats/Math/interface/deltaR.h"
#include "DataFormats/ParticleFlowReco/interface/PFRecHit.h"
#include "DataFormats/ParticleFlowReco/interface/PFRecHitFraction.h"
#include "FWCore/Framework/interface/ConsumesCollector.h"
#include "FWCore/MessageLogger/interface/MessageLogger.h"
#include "Math/GenVector/VectorUtil.h"
#include "RecoParticleFlow/PFClusterProducer/interface/PFClusterBuilderBase.h"
#include "CondFormats/DataRecord/interface/HcalPFCutsRcd.h"
#include "CondTools/Hcal/interface/HcalPFCutsHandler.h"
#include "vdt/vdtMath.h"

#include <iterator>
#include <unordered_map>

class PFMultiDepthClusterizer final : public PFClusterBuilderBase {
  typedef PFMultiDepthClusterizer B2DGPF;

public:
  PFMultiDepthClusterizer(const edm::ParameterSet& conf, edm::ConsumesCollector& cc);

  ~PFMultiDepthClusterizer() override = default;
  PFMultiDepthClusterizer(const B2DGPF&) = delete;
  B2DGPF& operator=(const B2DGPF&) = delete;

  void update(const edm::EventSetup& es) override { _allCellsPosCalc->update(es); }

  void buildClusters(const reco::PFClusterCollection&,
                     const std::vector<bool>&,
                     reco::PFClusterCollection& outclus,
                     const HcalPFCuts*) override;

private:
  std::unique_ptr<PFCPositionCalculatorBase> _allCellsPosCalc;
  double nSigmaEta_;
  double nSigmaPhi_;
  // timing settings
  const bool _useTiming;
  const double _timeThreshold;

  class ClusterLink {
  public:
    ClusterLink(unsigned int i, unsigned int j, double DR, int DZ, double energy) {
      from_ = i;
      to_ = j;
      linkDR_ = DR;
      linkDZ_ = DZ;
      linkE_ = energy;
    }

    ~ClusterLink() = default;

    unsigned int from() const { return from_; }
    unsigned int to() const { return to_; }
    double dR() const { return linkDR_; }
    int dZ() const { return linkDZ_; }
    double energy() const { return linkE_; }

  private:
    unsigned int from_;
    unsigned int to_;
    double linkDR_;
    int linkDZ_;
    double linkE_;
  };

  void calculateShowerShapes(const reco::PFClusterCollection&, std::vector<double>&, std::vector<double>&);
  std::vector<ClusterLink> link(const reco::PFClusterCollection&,
                                const std::vector<double>&,
                                const std::vector<double>&);
  std::vector<ClusterLink> prune(std::vector<ClusterLink>&, std::vector<bool>& linkedClusters);

  // rejected[idx] is set true for any depth cluster idx that absorbCluster rejects.
  void expandCluster(reco::PFCluster&,
                     unsigned int point,
                     std::vector<bool>& mask,
                     const reco::PFClusterCollection&,
                     const std::vector<ClusterLink>& links,
                     double refSeedTime,
                     std::vector<bool>& rejected);

  // Returns true if the cluster was absorbed, false if rejected by timing.
  bool absorbCluster(reco::PFCluster& main, const reco::PFCluster& added, double refSeedTime);
};

DEFINE_EDM_PLUGIN(PFClusterBuilderFactory, PFMultiDepthClusterizer, "PFMultiDepthClusterizer");

PFMultiDepthClusterizer::PFMultiDepthClusterizer(const edm::ParameterSet& conf, edm::ConsumesCollector& cc)
    : PFClusterBuilderBase(conf, cc),
      _useTiming(conf.getUntrackedParameter<bool>("useTiming", true)),
      _timeThreshold(conf.getUntrackedParameter<double>("timeThreshold", 5)) {
  const auto& acConf = conf.getParameterSet("allCellsPositionCalc");
  if (!acConf.empty()) {
    const std::string& algoac = acConf.getParameter<std::string>("algoName");
    if (!algoac.empty())
      _allCellsPosCalc = PFCPositionCalculatorFactory::get()->create(algoac, acConf, cc);
  }

  nSigmaEta_ = pow(conf.getParameter<double>("nSigmaEta"), 2);
  nSigmaPhi_ = pow(conf.getParameter<double>("nSigmaPhi"), 2);
}

void PFMultiDepthClusterizer::buildClusters(const reco::PFClusterCollection& input,
                                            const std::vector<bool>& seedable,
                                            reco::PFClusterCollection& output,
                                            const HcalPFCuts* hcalCuts) {
  std::vector<double> etaRMS2(input.size(), 0.0);
  std::vector<double> phiRMS2(input.size(), 0.0);

  calculateShowerShapes(input, etaRMS2, phiRMS2);

  auto&& links = link(input, etaRMS2, phiRMS2);

  std::vector<bool> mask(input.size(), false);
  std::vector<bool> linked(input.size(), false);
  std::vector<bool> rejected(input.size(), false);

  auto&& prunedLinks = prune(links, linked);

  for (unsigned int i = 0; i < input.size(); ++i) {
    if (mask[i])
      continue;
    if (!linked[i]) {
      output.push_back(input[i]);
      mask[i] = true;
      continue;
    }

    // Use input[i]'s seed time as the fixed reference for all timing checks
    // in this group.  No pre-pass needed.
    double refSeedTime = -999.0;
    for (const auto& frac : input[i].recHitFractions())
      if (frac.recHitRef()->detId() == input[i].seed()) {
        refSeedTime = frac.recHitRef()->time();
        break;
      }

    reco::PFCluster cluster = input[i];
    mask[i] = true;
    expandCluster(cluster, i, mask, input, prunedLinks, refSeedTime, rejected);
    _allCellsPosCalc->calculateAndSetPosition(cluster, hcalCuts);
    output.push_back(cluster);
  }

  // Iterative OOT passes: each pass ungroups clusters rejected in the previous
  // pass and re-clusters them using their own seed time as the timing reference.
  // Links are rebuilt from the original (pre-pruning) set filtered to only the
  // currently unmasked clusters, so OOT depth clusters that previously lost a
  // link to an IT cluster can now correctly find each other.
  while (true) {
    bool anyOOT = false;
    for (unsigned int i = 0; i < input.size(); ++i)
      if (rejected[i]) { mask[i] = false; anyOOT = true; }
    if (!anyOOT) break;

    std::fill(rejected.begin(), rejected.end(), false);

    // Rebuild spatial links among only the unmasked (OOT) clusters.
    std::vector<ClusterLink> ootLinks;
    for (const auto& lnk : links)
      if (!mask[lnk.from()] && !mask[lnk.to()])
        ootLinks.push_back(lnk);

    std::vector<bool> ootLinked(input.size(), false);
    auto&& ootPrunedLinks = prune(ootLinks, ootLinked);

    for (unsigned int i = 0; i < input.size(); ++i) {
      if (mask[i]) continue;
      if (!ootLinked[i]) {
        output.push_back(input[i]);
        mask[i] = true;
        continue;
      }
      double refSeedTimeOOT = -999.0;
      for (const auto& frac : input[i].recHitFractions())
        if (frac.recHitRef()->detId() == input[i].seed()) {
          refSeedTimeOOT = frac.recHitRef()->time();
          break;
        }
      reco::PFCluster cluster = input[i];
      mask[i] = true;
      expandCluster(cluster, i, mask, input, ootPrunedLinks, refSeedTimeOOT, rejected);
      _allCellsPosCalc->calculateAndSetPosition(cluster, hcalCuts);
      output.push_back(cluster);
    }
  }
}

void PFMultiDepthClusterizer::calculateShowerShapes(const reco::PFClusterCollection& clusters,
                                                    std::vector<double>& etaRMS2,
                                                    std::vector<double>& phiRMS2) {
  for (unsigned int i = 0; i < clusters.size(); ++i) {
    const reco::PFCluster& cluster = clusters[i];
    double etaSum = 0.0;
    double phiSum = 0.0;
    auto const& crep = cluster.positionREP();
    for (const auto& frac : cluster.recHitFractions()) {
      auto const& h = *frac.recHitRef();
      auto const& rep = h.positionREP();
      etaSum += (frac.fraction() * h.energy()) * std::abs(rep.eta() - crep.eta());
      phiSum += (frac.fraction() * h.energy()) * std::abs(deltaPhi(rep.phi(), crep.phi()));
    }
    etaRMS2[i] = std::max(etaSum / cluster.energy(), 0.1);
    etaRMS2[i] *= etaRMS2[i];
    phiRMS2[i] = std::max(phiSum / cluster.energy(), 0.1);
    phiRMS2[i] *= phiRMS2[i];
  }
}

std::vector<PFMultiDepthClusterizer::ClusterLink> PFMultiDepthClusterizer::link(
    const reco::PFClusterCollection& clusters, const std::vector<double>& etaRMS2, const std::vector<double>& phiRMS2) {
  std::vector<ClusterLink> links;
  for (unsigned int i = 0; i < clusters.size(); ++i)
    for (unsigned int j = 0; j < clusters.size(); ++j) {
      if (i == j)
        continue;

      const reco::PFCluster& cluster1 = clusters[i];
      const reco::PFCluster& cluster2 = clusters[j];

      auto dz = (static_cast<int>(cluster2.depth()) - static_cast<int>(cluster1.depth()));

      if (dz <= 0)
        continue;

      auto const& crep1 = cluster1.positionREP();
      auto const& crep2 = cluster2.positionREP();

      auto deta = crep1.eta() - crep2.eta();
      deta = deta * deta / (etaRMS2[i] + etaRMS2[j]);
      auto dphi = deltaPhi(crep1.phi(), crep2.phi());
      dphi = dphi * dphi / (phiRMS2[i] + phiRMS2[j]);

      if ((deta < nSigmaEta_) & (dphi < nSigmaPhi_))
        links.push_back(ClusterLink(i, j, deta + dphi, std::abs(dz), cluster1.energy() + cluster2.energy()));
    }

  return links;
}

std::vector<PFMultiDepthClusterizer::ClusterLink> PFMultiDepthClusterizer::prune(std::vector<ClusterLink>& links,
                                                                                 std::vector<bool>& linkedClusters) {
  std::vector<ClusterLink> goodLinks;
  std::vector<bool> mask(links.size(), false);
  if (links.empty())
    return goodLinks;

  for (unsigned int i = 0; i < links.size() - 1; ++i) {
    if (mask[i])
      continue;
    for (unsigned int j = i + 1; j < links.size(); ++j) {
      if (mask[j])
        continue;

      const ClusterLink& link1 = links[i];
      const ClusterLink& link2 = links[j];

      if (link1.to() == link2.to()) {
        if (link1.dZ() < link2.dZ()) {
          mask[j] = true;
        } else if (link1.dZ() > link2.dZ()) {
          mask[i] = true;
        } else {
          if (link1.dR() < link2.dR()) {
            mask[j] = true;
          } else if (link1.dR() > link2.dR()) {
            mask[i] = true;
          } else {
            if (link1.energy() < link2.energy())
              mask[i] = true;
            else
              mask[j] = true;
          }
        }
      }
    }
  }

  for (unsigned int i = 0; i < links.size(); ++i) {
    if (mask[i])
      continue;
    goodLinks.push_back(links[i]);
    linkedClusters[links[i].from()] = true;
    linkedClusters[links[i].to()] = true;
  }

  return goodLinks;
}

bool PFMultiDepthClusterizer::absorbCluster(reco::PFCluster& main,
                                            const reco::PFCluster& added,
                                            double refSeedTime) {
  // Seed timing cut against the fixed reference from input[i].
  // If the added cluster's seed falls outside the time window, reject the
  // entire depth cluster — no cells are added.
  if (_useTiming && refSeedTime > -998.0) {
    double addedSeedTime = -999.0;
    for (const auto& frac : added.recHitFractions())
      if (frac.recHitRef()->detId() == added.seed()) {
        addedSeedTime = frac.recHitRef()->time();
        break;
      }
    if (addedSeedTime > -998.0 && std::abs(addedSeedTime - refSeedTime) >= _timeThreshold)
      return false;  // reject entire depth cluster
  }

  double e1 = 0.0;
  double e2 = 0.0;

  for (const auto& fraction : main.recHitFractions())
    if (fraction.recHitRef()->detId() == main.seed())
      e1 = fraction.recHitRef()->energy();

  for (const auto& fraction : added.recHitFractions()) {
    main.addRecHitFraction(fraction);
    if (fraction.recHitRef()->detId() == added.seed())
      e2 = fraction.recHitRef()->energy();
  }
  if (e2 > e1)
    main.setSeed(added.seed());
  return true;
}

void PFMultiDepthClusterizer::expandCluster(reco::PFCluster& cluster,
                                            unsigned int point,
                                            std::vector<bool>& mask,
                                            const reco::PFClusterCollection& clusters,
                                            const std::vector<ClusterLink>& links,
                                            double refSeedTime,
                                            std::vector<bool>& rejected) {
  for (const auto& link : links) {
    if (link.from() == point) {
      if (!mask[link.from()]) {
        if (!absorbCluster(cluster, clusters[link.from()], refSeedTime))
          rejected[link.from()] = true;
        mask[link.from()] = true;
      }

      if (!mask[link.to()]) {
        if (absorbCluster(cluster, clusters[link.to()], refSeedTime)) {
          mask[link.to()] = true;
          expandCluster(cluster, link.to(), mask, clusters, links, refSeedTime, rejected);
        } else {
          rejected[link.to()] = true;
          mask[link.to()] = true;
        }
      }
    }
    if (link.to() == point) {
      if (!mask[link.to()]) {
        if (!absorbCluster(cluster, clusters[link.to()], refSeedTime))
          rejected[link.to()] = true;
        mask[link.to()] = true;
      }

      if (!mask[link.from()]) {
        if (absorbCluster(cluster, clusters[link.from()], refSeedTime)) {
          mask[link.from()] = true;
          expandCluster(cluster, link.from(), mask, clusters, links, refSeedTime, rejected);
        } else {
          rejected[link.from()] = true;
          mask[link.from()] = true;
        }
      }
    }
  }
}
